  {
    "type": "effect_on_condition",
    "id": "SGN_PT_EOC_time_wet",
    "//": "Day 105 of the year (turn 0 is the spring equinox, see sgn_doy in saigon_2000s region/weather.json) is early July, in the wet season (sgn_wet).  Then forward to 14:00, inside sgn_afternoon.",
    "effect": [
      { "math": [ "_pt_days = (105 - sgn_doy() + 364) % 364" ] },
      { "math": [ "time('now') = time('now') + _pt_days * time('1 d')" ] },
      { "math": [ "_pt_hours = (14 - time_since('midnight', 'unit':'hours') + 24) % 24" ] },
      { "math": [ "time('now') = time('now') + _pt_hours * time('1 h')" ] },
      "next_weather",
      {
        "u_message": "Playtest: it is now the wet season, early afternoon.  Wait for rain (or force it with the debug menu: Map… > Change weather).",
