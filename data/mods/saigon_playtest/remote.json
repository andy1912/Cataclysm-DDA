  {
    "type": "effect_on_condition",
    "id": "SGN_PT_EOC_goto",
    "//": "Teleport to the middle of the nearest overmap tile of type _omt on z 0 (a target_params search gives the tile's north-west corner, so +12 +12 is its centre; force_safe moves you off walls and creatures).  When nothing is found the search falls back to your own tile, so a result within 16 tiles counts as 'not found'.",
    "condition": { "expects_vars": [ "omt", "label" ] },
    "effect": [
      {
        "u_location_variable": { "context_val": "pt_loc" },
        "target_params": { "om_terrain": { "context_val": "omt" }, "z": 0, "reveal_radius": 2 },
        "x_adjust": 12,
        "y_adjust": 12
      },
      {
        "if": { "math": [ "distance('u', _pt_loc) <= 16" ] },
        "then": {
          "u_message": "No <context_val:label> found farther than this map square in the map generated so far.  Explore further, or use the debug menu (Teleport…).",
          "type": "bad"
        },
        "else": {
          "u_teleport": { "context_val": "pt_loc" },
          "force_safe": true,
          "success_message": "Playtest: you are at the nearest <context_val:label>.",
          "fail_message": "Playtest: the teleport failed (no free tile near the target)."
        }
      }
    ]
  },
