  {
    "type": "effect_on_condition",
    "id": "SGN_PT_EOC_veh_road_find",
    "//": "Find the nearest road overmap tile on z 0 (a target_params search gives its north-west corner): u_sgn_pt_veh is its middle, where the vehicle goes, u_sgn_pt_stand 4 tiles north of it, where the player goes.  mapgen_update takes only literal ids (npctalk.cpp f_mapgen_update reads a string or an array), so each vehicle has its own EOC.",
    "effect": [
      {
        "u_location_variable": { "u_val": "sgn_pt_veh" },
        "target_params": { "om_terrain": "road_", "om_terrain_match_type": "CONTAINS", "z": 0 },
        "x_adjust": 12,
        "y_adjust": 12
      },
      {
        "u_location_variable": { "u_val": "sgn_pt_stand" },
        "target_params": { "om_terrain": "road_", "om_terrain_match_type": "CONTAINS", "z": 0 },
        "x_adjust": 12,
        "y_adjust": 8
      }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "SGN_PT_EOC_veh_road_go",
    "effect": [
      {
        "u_teleport": { "u_val": "sgn_pt_stand" },
        "force_safe": true,
        "success_message": "Playtest: a test vehicle stands in the middle of this road square (look around with x).  If it is missing, something was in the way: try again on another road.",
        "fail_message": "Playtest: the vehicle was placed in the middle of the nearest road square, but you could not be moved there."
      }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "SGN_PT_EOC_veh_water_find",
    "//": "Find the nearest river_center, else lake_surface (the real map's rivers), overmap tile on z 0; u_sgn_pt_veh is its middle.  When nothing is found the search falls back to the player's own tile, so a result within 16 tiles sets u_sgn_pt_water_ok to 0.",
    "effect": [
      {
        "u_location_variable": { "u_val": "sgn_pt_veh" },
        "target_params": { "om_terrain": "river_center", "z": 0 },
        "x_adjust": 12,
        "y_adjust": 12
      },
      {
        "if": { "math": [ "distance('u', u_sgn_pt_veh) <= 16" ] },
        "then": {
          "u_location_variable": { "u_val": "sgn_pt_veh" },
          "target_params": { "om_terrain": "lake_surface", "z": 0 },
          "x_adjust": 12,
          "y_adjust": 12
        }
      },
      {
        "if": { "math": [ "distance('u', u_sgn_pt_veh) <= 16" ] },
        "then": [
          { "math": [ "u_sgn_pt_water_ok = 0" ] },
          {
