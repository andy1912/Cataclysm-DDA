[
  {
    "type": "ITEM",
    "id": "sgn_pt_remote",
    "subtypes": [ "TOOL" ],
    "name": { "str": "playtest remote (cheat)", "str_pl": "playtest remotes (cheat)" },
    "description": "A testing cheat from the saigon_playtest mod, not part of the world.  Activate it for a menu: teleport to the nearest place of a kind, skip time, spawn a test vehicle, heal, damage protection, reveal the map, clear nearby monsters, spawn zombies, flood or drain the streets, and the playtest kit again.",
    "weight": "100 g",
    "volume": "100 ml",
    "price": "0 cent",
    "price_postapoc": "0 cent",
    "material": [ "plastic" ],
    "symbol": ";",
    "color": "light_red",
    "looks_like": "two_way_radio",
    "flags": [ "TRADER_AVOID" ],
    "use_action": {
      "type": "effect_on_conditions",
      "menu_text": "Open the playtest menu",
      "description": "Teleport, time, vehicles, healing and other testing cheats.",
      "effect_on_conditions": [ "SGN_PT_EOC_menu" ]
    }
  },
  {
    "type": "effect_type",
    "id": "sgn_pt_god",
    "name": [ "Playtest protection" ],
    "desc": [ "Cheat from the playtest remote: incoming damage is cancelled and wounds heal fast." ],
    "rating": "good",
    "max_intensity": 1,
    "show_in_info": true,
    "enchantments": [
      {
        "condition": "ALWAYS",
        "incoming_damage_mod": [
          { "type": "bash", "multiply": -1 },
          { "type": "cut", "multiply": -1 },
          { "type": "stab", "multiply": -1 },
          { "type": "bullet", "multiply": -1 },
          { "type": "heat", "multiply": -1 },
          { "type": "cold", "multiply": -1 },
          { "type": "acid", "multiply": -1 },
          { "type": "electric", "multiply": -1 },
          { "type": "biological", "multiply": -1 }
